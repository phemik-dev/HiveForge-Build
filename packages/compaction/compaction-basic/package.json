{
  "name": "@hiveforge-ai/dsh-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the HiveForge Harness",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiveforge-ai/hiveforge-harness.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hiveforge-ai/dsh-agent": "workspace:^",
    "@hiveforge-ai/dsh-compaction": "workspace:^",
    "@hiveforge-ai/dsh-commands": "workspace:^",
    "@hiveforge-ai/dsh-invariants": "workspace:^",
    "@hiveforge-ai/dsh-llm": "workspace:^",
    "@hiveforge-ai/dsh-session": "workspace:^",
    "@hiveforge-ai/dsh-token-meter": "workspace:^",
    "@hiveforge-ai/dsh-compaction-tool-result-pruner": "workspace:^",
    "@hiveforge-ai/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@hiveforge-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@hiveforge-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hiveforge-ai/cordis-plugin-include": "workspace:^",
    "@hiveforge-ai/cordis-plugin-loader": "workspace:^",
    "@hiveforge-ai/dsh-agent": "workspace:^",
    "@hiveforge-ai/dsh-agent-loop": "workspace:^",
    "@hiveforge-ai/dsh-agent-loop-testkit": "workspace:^",
    "@hiveforge-ai/dsh-compaction": "workspace:^",
    "@hiveforge-ai/dsh-commands": "workspace:^",
    "@hiveforge-ai/dsh-invariants": "workspace:^",
    "@hiveforge-ai/dsh-llm": "workspace:^",
    "@hiveforge-ai/dsh-llm-retry": "workspace:^",
    "@hiveforge-ai/dsh-session": "workspace:^",
    "@hiveforge-ai/dsh-token-meter": "workspace:^",
    "@hiveforge-ai/dsh-compaction-tool-result-pruner": "workspace:^",
    "@hiveforge-ai/dsh-tools": "workspace:^",
    "@hiveforge-ai/cordis": "workspace:^"
  }
}

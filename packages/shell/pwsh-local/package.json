{
  "name": "@hiveforge-ai/dsh-pwsh-local",
  "description": "Local PowerShell implementation of the HiveForge Harness bash executor seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiveforge-ai/hiveforge-harness.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hiveforge-ai/dsh-shell": "workspace:^",
    "@hiveforge-ai/dsh-invariants": "workspace:^",
    "@hiveforge-ai/dsh-subprocess": "workspace:^",
    "@hiveforge-ai/dsh-timeout": "workspace:^",
    "@hiveforge-ai/cordis": "workspace:^",
    "@hiveforge-ai/dsh-settings": "workspace:^"
  },
  "dependencies": {
    "@hiveforge-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@hiveforge-ai/dsh-shell": "workspace:^",
    "@hiveforge-ai/dsh-invariants": "workspace:^",
    "@hiveforge-ai/dsh-subprocess": "workspace:^",
    "@hiveforge-ai/dsh-subprocess-local": "workspace:^",
    "@hiveforge-ai/dsh-timeout": "workspace:^",
    "@hiveforge-ai/cordis": "workspace:^",
    "@hiveforge-ai/dsh-settings": "workspace:^"
  }
}
